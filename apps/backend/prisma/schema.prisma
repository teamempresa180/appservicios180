// Prisma schema — Sprint 3, Etapa 2 (Identity & Access) + Etapa 3
// (Profile) + Etapa 4 (Contact & Address) + Etapa 5 (Verification,
// Trust & Audit) + Etapa 6 (Category & Service) + Etapa 7 (Provider,
// Availability & Schedule) + Etapa 8 (Fulfillment: Order & Quote).
//
// Only the persistence shape for `identity`/`authentication`/
// `credentials`/`profiles`/`contact`/`address`/`verification`/
// `trust`/`audit`/`category`/`service`/`provider`/`availability`/
// `schedule`/`order`/`quote` (bounded contexts implemented end-to-end
// so far). Every other module's tables are added when that module
// gets its own Infrastructure layer, following the roadmap in
// `SPRINT3_PREPARATION.md` — not created speculatively here.
//
// `OrderModel.identityId`/`providerId`/`serviceId` and
// `QuoteModel.orderId`/`providerId` are real `@relation`s — Identity,
// Provider and Service all already had tables by the time Order/Quote
// were implemented (Sprint 3, Etapa 8), so no relation was deferred.
// `QuoteModel.orderId` is a plain indexed column (not unique): an
// Order may receive multiple Quotes from different Providers —
// `QuoteRepository.findByOrderId` returns `Quote[]`, confirmed from
// the domain code itself, not assumed from prior notes.
//
// `ServiceModel.providerId` is now a real `@relation` to
// `ProviderModel` (Sprint 3, Etapa 7) — Prompt 63 left it as a plain
// indexed String column because `Provider` had no table yet; now that
// it does, the relation was completed (see `PROJECT_STATUS.md`,
// section "Prompt 64", for the full resolution).
// There is no `MarketplaceModel`/`SearchModel` — neither exists as a
// domain entity; "Marketplace" is satisfied by Category+Service+
// Provider, "Search" by the per-model `search()` repository method,
// same as every other module.
//
// Field names/types mirror each domain entity's `Props` interface
// exactly (see `domain/entities/*.entity.ts`); enums mirror each
// domain value object's TypeScript enum 1:1. Domain/Application never
// import from this file or from `@prisma/client` — only
// `infrastructure/persistence/*.mapper.ts` in each module does.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  FOREIGN_ID
  TAX_ID
  OTHER

  @@map("document_type")
}

enum IdentityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("identity_status")
}

enum AuthMethodType {
  PASSWORD
  BIOMETRIC
  ONE_TIME_CODE
  THIRD_PARTY
  OTHER

  @@map("auth_method_type")
}

enum AuthenticationStatus {
  ACTIVE
  INACTIVE
  LOCKED
  REVOKED

  @@map("authentication_status")
}

enum CredentialType {
  PASSWORD
  RECOVERY_CODE
  SECURITY_KEY
  OTHER

  @@map("credential_type")
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@map("credential_status")
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  CONTACTS_ONLY

  @@map("profile_visibility")
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("profile_status")
}

enum ContactType {
  EMAIL
  PHONE
  OTHER

  @@map("contact_type")
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("contact_status")
}

enum AddressType {
  HOME
  WORK
  BILLING
  SERVICE
  EMERGENCY
  OTHER

  @@map("address_type")
}

enum AddressStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("address_status")
}

enum VerificationType {
  DOCUMENT
  FACIAL
  ADDRESS
  PHONE
  EMAIL
  OTHER

  @@map("verification_type")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("verification_status")
}

enum TrustLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("trust_level")
}

enum TrustStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("trust_status")
}

enum AuditActionType {
  CREATED
  UPDATED
  DELETED
  ACCESSED
  LOGGED_IN
  LOGGED_OUT
  OTHER

  @@map("audit_action_type")
}

enum CategoryType {
  STANDARD
  PREMIUM
  SEASONAL
  OTHER

  @@map("category_type")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("category_status")
}

enum ServiceType {
  STANDARD
  EXPRESS
  CUSTOM
  OTHER

  @@map("service_type")
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("service_status")
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("provider_status")
}

enum ProviderType {
  INDEPENDENT
  FREELANCER
  COMPANY
  OTHER

  @@map("provider_type")
}

enum ProviderExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("provider_experience")
}

enum AvailabilityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("availability_status")
}

enum AvailabilityType {
  FULL_TIME
  PART_TIME
  ON_DEMAND
  SEASONAL
  OTHER

  @@map("availability_type")
}

enum ScheduleStatus {
  OPEN
  BLOCKED
  CANCELLED
  COMPLETED

  @@map("schedule_status")
}

enum ScheduleType {
  REGULAR
  BLOCKED
  SPECIAL
  OTHER

  @@map("schedule_type")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED

  @@map("order_status")
}

enum OrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("order_priority")
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN

  @@map("quote_status")
}

enum QuoteType {
  STANDARD
  DETAILED
  ESTIMATE
  OTHER

  @@map("quote_type")
}

model IdentityModel {
  id             String         @id
  fullName       String         @map("full_name")
  documentType   DocumentType   @map("document_type")
  documentNumber String         @map("document_number")
  birthDate      DateTime       @map("birth_date")
  status         IdentityStatus
  createdAt      DateTime       @map("created_at")
  updatedAt      DateTime       @map("updated_at")

  authentications AuthenticationModel[]
  credentials     CredentialModel[]
  profiles        ProfileModel[]
  contacts        ContactModel[]
  addresses       AddressModel[]
  verifications   VerificationModel[]
  trust           TrustModel?
  auditRecords    AuditModel[]
  provider        ProviderModel?
  orders          OrderModel[]

  @@map("identities")
}

model AuthenticationModel {
  id         String               @id
  identityId String               @map("identity_id")
  methodType AuthMethodType       @map("method_type")
  status     AuthenticationStatus
  createdAt  DateTime             @map("created_at")
  updatedAt  DateTime             @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("authentications")
}

model CredentialModel {
  id         String           @id
  identityId String           @map("identity_id")
  type       CredentialType
  status     CredentialStatus
  createdAt  DateTime         @map("created_at")
  updatedAt  DateTime         @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("credentials")
}

model ProfileModel {
  id          String            @id
  identityId  String            @map("identity_id")
  displayName String            @map("display_name")
  avatarUrl   String?           @map("avatar_url")
  bio         String?
  visibility  ProfileVisibility
  status      ProfileStatus
  createdAt   DateTime          @map("created_at")
  updatedAt   DateTime          @map("updated_at")

  identity  IdentityModel   @relation(fields: [identityId], references: [id])
  providers ProviderModel[]

  @@index([identityId])
  @@map("profiles")
}

model ContactModel {
  id         String        @id
  identityId String        @map("identity_id")
  type       ContactType
  value      String
  status     ContactStatus
  createdAt  DateTime      @map("created_at")
  updatedAt  DateTime      @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("contacts")
}

model AddressModel {
  id          String        @id
  identityId  String        @map("identity_id")
  alias       String
  fullAddress String        @map("full_address")
  city        String
  state       String
  country     String
  postalCode  String        @map("postal_code")
  type        AddressType
  status      AddressStatus
  createdAt   DateTime      @map("created_at")
  updatedAt   DateTime      @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("addresses")
}

model VerificationModel {
  id         String              @id
  identityId String              @map("identity_id")
  type       VerificationType
  status     VerificationStatus
  verifiedAt DateTime?           @map("verified_at")
  createdAt  DateTime            @map("created_at")
  updatedAt  DateTime            @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("verifications")
}

model TrustModel {
  id         String      @id
  identityId String      @unique @map("identity_id")
  score      Int
  level      TrustLevel
  status     TrustStatus
  createdAt  DateTime    @map("created_at")
  updatedAt  DateTime    @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@map("trust_profiles")
}

model AuditModel {
  id          String           @id
  identityId  String           @map("identity_id")
  actionType  AuditActionType  @map("action_type")
  description String
  occurredAt  DateTime         @map("occurred_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("audit_records")
}

model CategoryModel {
  id          String         @id
  name        String
  description String
  icon        String
  color       String
  status      CategoryStatus
  type        CategoryType
  createdAt   DateTime       @map("created_at")
  updatedAt   DateTime       @map("updated_at")

  services ServiceModel[]

  @@map("categories")
}

model ServiceModel {
  id                String        @id
  providerId        String        @map("provider_id")
  categoryId        String        @map("category_id")
  name              String
  description       String
  basePrice         Float         @map("base_price")
  estimatedDuration Int           @map("estimated_duration")
  status            ServiceStatus
  type              ServiceType
  createdAt         DateTime      @map("created_at")
  updatedAt         DateTime      @map("updated_at")

  category CategoryModel @relation(fields: [categoryId], references: [id])
  provider ProviderModel @relation(fields: [providerId], references: [id])
  orders   OrderModel[]

  @@index([providerId])
  @@index([categoryId])
  @@map("services")
}

model ProviderModel {
  id                String             @id
  identityId        String             @unique @map("identity_id")
  providerProfileId String             @map("provider_profile_id")
  status            ProviderStatus
  type              ProviderType
  experience        ProviderExperience
  biography         String
  yearsOfExperience Int                @map("years_of_experience")
  createdAt         DateTime           @map("created_at")
  updatedAt         DateTime           @map("updated_at")

  identity      IdentityModel        @relation(fields: [identityId], references: [id])
  profile       ProfileModel         @relation(fields: [providerProfileId], references: [id])
  services      ServiceModel[]
  availabilities AvailabilityModel[]
  schedules     ScheduleModel[]
  orders        OrderModel[]
  quotes        QuoteModel[]

  @@index([providerProfileId])
  @@map("providers")
}

model AvailabilityModel {
  id            String             @id
  providerId    String             @map("provider_id")
  status        AvailabilityStatus
  type          AvailabilityType
  availableFrom DateTime           @map("available_from")
  availableTo   DateTime           @map("available_to")
  createdAt     DateTime           @map("created_at")
  updatedAt     DateTime           @map("updated_at")

  provider ProviderModel @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("availabilities")
}

model ScheduleModel {
  id            String         @id
  providerId    String         @map("provider_id")
  startDateTime DateTime       @map("start_date_time")
  endDateTime   DateTime       @map("end_date_time")
  status        ScheduleStatus
  type          ScheduleType
  createdAt     DateTime       @map("created_at")
  updatedAt     DateTime       @map("updated_at")

  provider ProviderModel @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("schedules")
}

model OrderModel {
  id            String        @id
  identityId    String        @map("identity_id")
  providerId    String        @map("provider_id")
  serviceId     String        @map("service_id")
  title         String
  description   String
  scheduledDate DateTime      @map("scheduled_date")
  status        OrderStatus
  priority      OrderPriority
  createdAt     DateTime      @map("created_at")
  updatedAt     DateTime      @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])
  provider ProviderModel @relation(fields: [providerId], references: [id])
  service  ServiceModel  @relation(fields: [serviceId], references: [id])
  quotes   QuoteModel[]

  @@index([identityId])
  @@index([providerId])
  @@index([serviceId])
  @@map("orders")
}

model QuoteModel {
  id                String      @id
  orderId           String      @map("order_id")
  providerId        String      @map("provider_id")
  proposedPrice     Float       @map("proposed_price")
  estimatedDuration Int         @map("estimated_duration")
  notes             String
  status            QuoteStatus
  type              QuoteType
  createdAt         DateTime    @map("created_at")
  updatedAt         DateTime    @map("updated_at")

  order    OrderModel    @relation(fields: [orderId], references: [id])
  provider ProviderModel @relation(fields: [providerId], references: [id])

  @@index([orderId])
  @@index([providerId])
  @@map("quotes")
}
