// Prisma schema — Sprint 3, Etapa 2 (Identity & Access) + Etapa 3
// (Profile) + Etapa 4 (Contact & Address) + Etapa 5 (Verification,
// Trust & Audit) + Etapa 6 (Category & Service).
//
// Only the persistence shape for `identity`/`authentication`/
// `credentials`/`profiles`/`contact`/`address`/`verification`/
// `trust`/`audit`/`category`/`service` (bounded contexts implemented
// end-to-end so far). Every other module's tables are added when that
// module gets its own Infrastructure layer, following the roadmap in
// `SPRINT3_PREPARATION.md` — not created speculatively here.
//
// `ServiceModel.providerId` is a plain indexed String column, no
// `@relation` — the Provider bounded context has no table yet (see
// `PROJECT_STATUS.md`, section "Prompt 63", for the audit finding on
// why Provider verification/FK is deferred to a future stage).
// There is no `MarketplaceModel`/`SearchModel` — neither exists as a
// domain entity; "Marketplace" is satisfied by Category+Service(+
// Provider later), "Search" by the per-model `search()` repository
// method, same as every other module.
//
// Field names/types mirror each domain entity's `Props` interface
// exactly (see `domain/entities/*.entity.ts`); enums mirror each
// domain value object's TypeScript enum 1:1. Domain/Application never
// import from this file or from `@prisma/client` — only
// `infrastructure/persistence/*.mapper.ts` in each module does.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  FOREIGN_ID
  TAX_ID
  OTHER

  @@map("document_type")
}

enum IdentityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED

  @@map("identity_status")
}

enum AuthMethodType {
  PASSWORD
  BIOMETRIC
  ONE_TIME_CODE
  THIRD_PARTY
  OTHER

  @@map("auth_method_type")
}

enum AuthenticationStatus {
  ACTIVE
  INACTIVE
  LOCKED
  REVOKED

  @@map("authentication_status")
}

enum CredentialType {
  PASSWORD
  RECOVERY_CODE
  SECURITY_KEY
  OTHER

  @@map("credential_type")
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@map("credential_status")
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  CONTACTS_ONLY

  @@map("profile_visibility")
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("profile_status")
}

enum ContactType {
  EMAIL
  PHONE
  OTHER

  @@map("contact_type")
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("contact_status")
}

enum AddressType {
  HOME
  WORK
  BILLING
  SERVICE
  EMERGENCY
  OTHER

  @@map("address_type")
}

enum AddressStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("address_status")
}

enum VerificationType {
  DOCUMENT
  FACIAL
  ADDRESS
  PHONE
  EMAIL
  OTHER

  @@map("verification_type")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("verification_status")
}

enum TrustLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("trust_level")
}

enum TrustStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("trust_status")
}

enum AuditActionType {
  CREATED
  UPDATED
  DELETED
  ACCESSED
  LOGGED_IN
  LOGGED_OUT
  OTHER

  @@map("audit_action_type")
}

enum CategoryType {
  STANDARD
  PREMIUM
  SEASONAL
  OTHER

  @@map("category_type")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("category_status")
}

enum ServiceType {
  STANDARD
  EXPRESS
  CUSTOM
  OTHER

  @@map("service_type")
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("service_status")
}

model IdentityModel {
  id             String         @id
  fullName       String         @map("full_name")
  documentType   DocumentType   @map("document_type")
  documentNumber String         @map("document_number")
  birthDate      DateTime       @map("birth_date")
  status         IdentityStatus
  createdAt      DateTime       @map("created_at")
  updatedAt      DateTime       @map("updated_at")

  authentications AuthenticationModel[]
  credentials     CredentialModel[]
  profiles        ProfileModel[]
  contacts        ContactModel[]
  addresses       AddressModel[]
  verifications   VerificationModel[]
  trust           TrustModel?
  auditRecords    AuditModel[]

  @@map("identities")
}

model AuthenticationModel {
  id         String               @id
  identityId String               @map("identity_id")
  methodType AuthMethodType       @map("method_type")
  status     AuthenticationStatus
  createdAt  DateTime             @map("created_at")
  updatedAt  DateTime             @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("authentications")
}

model CredentialModel {
  id         String           @id
  identityId String           @map("identity_id")
  type       CredentialType
  status     CredentialStatus
  createdAt  DateTime         @map("created_at")
  updatedAt  DateTime         @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("credentials")
}

model ProfileModel {
  id          String            @id
  identityId  String            @map("identity_id")
  displayName String            @map("display_name")
  avatarUrl   String?           @map("avatar_url")
  bio         String?
  visibility  ProfileVisibility
  status      ProfileStatus
  createdAt   DateTime          @map("created_at")
  updatedAt   DateTime          @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("profiles")
}

model ContactModel {
  id         String        @id
  identityId String        @map("identity_id")
  type       ContactType
  value      String
  status     ContactStatus
  createdAt  DateTime      @map("created_at")
  updatedAt  DateTime      @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("contacts")
}

model AddressModel {
  id          String        @id
  identityId  String        @map("identity_id")
  alias       String
  fullAddress String        @map("full_address")
  city        String
  state       String
  country     String
  postalCode  String        @map("postal_code")
  type        AddressType
  status      AddressStatus
  createdAt   DateTime      @map("created_at")
  updatedAt   DateTime      @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("addresses")
}

model VerificationModel {
  id         String              @id
  identityId String              @map("identity_id")
  type       VerificationType
  status     VerificationStatus
  verifiedAt DateTime?           @map("verified_at")
  createdAt  DateTime            @map("created_at")
  updatedAt  DateTime            @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("verifications")
}

model TrustModel {
  id         String      @id
  identityId String      @unique @map("identity_id")
  score      Int
  level      TrustLevel
  status     TrustStatus
  createdAt  DateTime    @map("created_at")
  updatedAt  DateTime    @map("updated_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@map("trust_profiles")
}

model AuditModel {
  id          String           @id
  identityId  String           @map("identity_id")
  actionType  AuditActionType  @map("action_type")
  description String
  occurredAt  DateTime         @map("occurred_at")

  identity IdentityModel @relation(fields: [identityId], references: [id])

  @@index([identityId])
  @@map("audit_records")
}

model CategoryModel {
  id          String         @id
  name        String
  description String
  icon        String
  color       String
  status      CategoryStatus
  type        CategoryType
  createdAt   DateTime       @map("created_at")
  updatedAt   DateTime       @map("updated_at")

  services ServiceModel[]

  @@map("categories")
}

model ServiceModel {
  id                String        @id
  providerId        String        @map("provider_id")
  categoryId        String        @map("category_id")
  name              String
  description       String
  basePrice         Float         @map("base_price")
  estimatedDuration Int           @map("estimated_duration")
  status            ServiceStatus
  type              ServiceType
  createdAt         DateTime      @map("created_at")
  updatedAt         DateTime      @map("updated_at")

  category CategoryModel @relation(fields: [categoryId], references: [id])

  @@index([providerId])
  @@index([categoryId])
  @@map("services")
}
