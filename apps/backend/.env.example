# Template only — copy to `.env` locally, never commit real values.
# `.env` is already git-ignored (see root .gitignore).
#
# Only the variables the app actually reads today (validated in
# src/config/env.validation.ts).
#
# DATABASE_URL added in Sprint 3, Etapa 2 — Identity & Access is the
# first module with a real Prisma/PostgreSQL-backed repository. Point
# it at your own local Postgres (e.g. via Docker):
#   docker run -d --name appservicios-pg -e POSTGRES_USER=appservicios \
#     -e POSTGRES_PASSWORD=appservicios -e POSTGRES_DB=appservicios \
#     -p 5432:5432 postgres:16-alpine
# No JWT/Firebase credentials yet — those are added when the module
# that needs them is implemented, not before (see
# apps/backend/src/modules/core/README.md).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://appservicios:appservicios@localhost:5432/appservicios
