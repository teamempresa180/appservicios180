# Reference only — Railway (or any other host) doesn't read this file.
# Copy each of these into the platform's own environment-variables UI
# (or `railway variables set KEY=value`). Never commit real values.

NODE_ENV=production

# Railway injects PORT automatically — do not set it manually there.
# PORT=3000

# The same real MySQL server already used for Alpha testing. Percent-encode
# any special character in the password (@ : / ? # [ ] etc.) — see
# apps/backend/.env.example for the encoding note.
DATABASE_URL=mysql://<user>:<url-encoded-password>@<host>:3306/<schema>

# REQUIRED in production — the app fails fast at boot if either is
# missing (see src/config/env.validation.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT random values — never reuse one secret for both.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=servicios180-api
JWT_AUDIENCE=servicios180-clients

# Comma-separated list of allowed origins once real client domains are
# known (e.g. the Flutter app doesn't send an Origin header, so this
# mainly matters if a web/admin frontend is added later). `*` is kept
# for Alpha since every caller today is the mobile app over HTTPS with
# a Bearer token, not cookies — no CSRF exposure from a permissive CORS
# policy in this app's current auth model.
CORS_ORIGIN=*
