<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP (cleartext) only to the local dev backend hosts.
  Android blocks cleartext by default since API 28, and the backend
  (apps/backend) has no HTTPS setup yet since it only runs on a dev
  machine / LAN for now. Update the LAN IP below if the dev machine's
  address changes (see apps/mobile/lib/core/network/api_config.dart,
  set via the dart-define API_BASE_URL flag).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.10.11</domain>
    </domain-config>
</network-security-config>
